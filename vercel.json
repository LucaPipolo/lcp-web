{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "crons": [
    {
      "path": "/api/cleanup/",
      "schedule": "0 3 * * *"
    }
  ],
  "functions": {
    "api/contact.ts": {
      "includeFiles": "src/content/pages/{contact,privacy}/*.yaml"
    },
    "api/notify.ts": {
      "includeFiles": "src/content/{emails/notice,pages/contact,pages/privacy}/*.yaml"
    }
  },
  "redirects": [
    {
      "source": "/contact{/}?",
      "destination": "/contacto/",
      "permanent": true
    },
    {
      "source": "/imprint{/}?",
      "destination": "/aviso-legal/",
      "permanent": true
    },
    {
      "source": "/privacy{/}?",
      "destination": "/privacidad/",
      "permanent": true
    },
    {
      "source": "/security{/}?",
      "destination": "/seguridad/",
      "permanent": true
    },
    {
      "source": "/ai-content{/}?",
      "destination": "/contenido-ia/",
      "permanent": true
    },
    {
      "source": "/recommendations{/}?",
      "destination": "/recomendaciones/",
      "permanent": true
    },
    {
      "source": "/it/contact{/}?",
      "destination": "/it/contatti/",
      "permanent": true
    },
    {
      "source": "/it/imprint{/}?",
      "destination": "/it/note-legali/",
      "permanent": true
    },
    {
      "source": "/it/cookies{/}?",
      "destination": "/it/cookie/",
      "permanent": true
    },
    {
      "source": "/it/security{/}?",
      "destination": "/it/sicurezza/",
      "permanent": true
    },
    {
      "source": "/it/ai-content{/}?",
      "destination": "/it/contenuti-ia/",
      "permanent": true
    },
    {
      "source": "/it/recommendations{/}?",
      "destination": "/it/raccomandazioni/",
      "permanent": true
    },
    {
      "source": "/blog/building-rift{/}?",
      "destination": "/blog/agentes-ia-en-paralelo-con-docker/",
      "permanent": true
    },
    {
      "source": "/en/blog/building-rift{/}?",
      "destination": "/en/blog/parallel-ai-agents-with-docker/",
      "permanent": true
    },
    {
      "source": "/it/blog/building-rift{/}?",
      "destination": "/it/blog/agenti-ai-in-parallelo-con-docker/",
      "permanent": true
    },
    {
      "source": "/resumes/luca-pipolo-full-stack-developer-resume-es.pdf",
      "destination": "/resumes/luca-pipolo-desarrollador-full-stack-cv.pdf",
      "permanent": true
    },
    {
      "source": "/resumes/luca-pipolo-full-stack-developer-resume-it.pdf",
      "destination": "/resumes/luca-pipolo-full-stack-developer-cv.pdf",
      "permanent": true
    },
    {
      "source": "/blog/building-the-contact-form{/}?",
      "destination": "/blog/formulario-de-contacto-sin-spam/",
      "permanent": true
    },
    {
      "source": "/en/blog/building-the-contact-form{/}?",
      "destination": "/en/blog/spam-free-contact-form/",
      "permanent": true
    },
    {
      "source": "/it/blog/building-the-contact-form{/}?",
      "destination": "/it/blog/modulo-di-contatto-senza-spam/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self' 'sha256-XNWcCgXyPiuW2okwSokT3ZHPnUlL8V+M0j1sIhEhz5I=' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://o388146.ingest.us.sentry.io; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests; report-uri https://o388146.ingest.us.sentry.io/api/4511896576983040/security/?sentry_key=5dfa2e82510f22215199bf30a53f0a5a"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "accelerometer=(), autoplay=(), browsing-topics=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "off"
        }
      ]
    }
  ]
}
