---
import "@/styles/global.css"

import Analytics from "@vercel/analytics/astro"
import SpeedInsights from "@vercel/speed-insights/astro"

import ButtonLink from "@/components/common/ButtonLink.astro"

import CommandPalette from "@/components/sections/CommandPalette/CommandPalette.astro"

import SiteFooter from "@/components/sections/SiteFooter/SiteFooter.astro"
import SiteFooterColophon from "@/components/sections/SiteFooter/SiteFooterColophon.astro"
import SiteFooterColumn from "@/components/sections/SiteFooter/SiteFooterColumn.astro"
import SiteFooterLink from "@/components/sections/SiteFooter/SiteFooterLink.astro"

import SiteHeader from "@/components/sections/SiteHeader/SiteHeader.astro"
import SiteHeaderLink from "@/components/sections/SiteHeader/SiteHeaderLink.astro"
import ThemeToggle from "@/components/sections/SiteHeader/ThemeToggle.astro"

import { getFeedHref } from "@/libs/blog"
import { BRAND_COLORS } from "@/libs/brand"
import { getSettings } from "@/libs/content"
import {
  type Alternates,
  DEFAULT_LOCALE,
  getOpenGraphLocale,
  isLocale,
  LOCALES,
  localizeHref,
} from "@/libs/i18n"
import { getOgImageHref, OG_IMAGE_SIZE } from "@/libs/og"
import {
  getStructuredData,
  type PageType,
  type SchemaNode,
} from "@/libs/structured-data"
import { fillPlaceholders } from "@/libs/template"

import { THEME_INIT_SOURCE } from "@/scripts/theme-init"

interface Props {
  alternates?: Alternates
  article?: { modified?: Date; published: Date; tags: string[] }
  description?: string
  nodes?: SchemaNode[]
  noindex?: boolean
  title: string
  type?: PageType
}

const {
  alternates = {},
  article,
  description,
  nodes,
  noindex = false,
  title,
  type = "WebPage",
} = Astro.props

const locale = isLocale(Astro.currentLocale)
  ? Astro.currentLocale
  : DEFAULT_LOCALE
const homeHref = localizeHref("/", locale)

const absolute = (href: string) => new URL(href, Astro.site).href

const canonical = absolute(alternates[locale] ?? Astro.url.pathname)
const translations = LOCALES.flatMap((code) => {
  const href = alternates[code]
  return href ? [{ code, href: absolute(href) }] : []
})
const fallback = alternates[DEFAULT_LOCALE]

const structuredData = await getStructuredData({
  description,
  locale,
  nodes,
  site: Astro.site!,
  title,
  type,
  url: canonical,
})

const { author, blog, footer, header } = await getSettings(locale)

const ogImage = absolute(
  getOgImageHref(alternates[locale] ?? Astro.url.pathname)
)
const ogType = article
  ? "article"
  : type === "ProfilePage"
    ? "profile"
    : "website"

const copyright =
  footer &&
  fillPlaceholders(footer.copyright, {
    year: String(new Date().getFullYear()),
  })
---

<html lang={Astro.currentLocale}>
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width" name="viewport" />
    <link href="/favicon.svg" rel="icon" type="image/svg+xml" />
    <link href="/apple-touch-icon.png" rel="apple-touch-icon" />
    <link href="/site.webmanifest" rel="manifest" />
    <meta
      content={BRAND_COLORS.background}
      media="(prefers-color-scheme: light)"
      name="theme-color"
    />
    <meta
      content={BRAND_COLORS.darkBackground}
      media="(prefers-color-scheme: dark)"
      name="theme-color"
    />
    <title>{title}</title>
    {description && <meta content={description} name="description" />}
    <meta content={author.name} name="author" />
    <link
      href={getFeedHref(locale)}
      rel="alternate"
      title={blog.feed}
      type="application/rss+xml"
    />
    {noindex ? (
      <meta content="noindex" name="robots" />
    ) : (
      <>
        <link href={canonical} rel="canonical" />
        {translations.map(({ code, href }) => (
          <link href={href} hreflang={code} rel="alternate" />
        ))}
        {fallback && (
          <link
            href={absolute(fallback)}
            hreflang="x-default"
            rel="alternate"
          />
        )}
        <script
          is:inline
          set:html={structuredData}
          type="application/ld+json"
        />
        <meta content={author.name} property="og:site_name" />
        <meta content={ogType} property="og:type" />
        <meta content={title} property="og:title" />
        {description && (
          <meta content={description} property="og:description" />
        )}
        <meta content={canonical} property="og:url" />
        <meta content={getOpenGraphLocale(locale)} property="og:locale" />
        {translations
          .filter(({ code }) => code !== locale)
          .map(({ code }) => (
            <meta
              content={getOpenGraphLocale(code)}
              property="og:locale:alternate"
            />
          ))}
        <meta content={ogImage} property="og:image" />
        <meta content="image/png" property="og:image:type" />
        <meta content={String(OG_IMAGE_SIZE.width)} property="og:image:width" />
        <meta
          content={String(OG_IMAGE_SIZE.height)}
          property="og:image:height"
        />
        <meta content={title} property="og:image:alt" />
        <meta content="summary_large_image" name="twitter:card" />
        {article && (
          <>
            <meta
              content={article.published.toISOString()}
              property="article:published_time"
            />
            <meta
              content={(article.modified ?? article.published).toISOString()}
              property="article:modified_time"
            />
            <meta content={absolute(homeHref)} property="article:author" />
            {article.tags.map((tag) => (
              <meta content={tag} property="article:tag" />
            ))}
          </>
        )}
      </>
    )}
    <script is:inline set:html={THEME_INIT_SOURCE}></script>
    <Analytics />
    <SpeedInsights />
  </head>
  <body>
    <a
      class="sr-only bg-foreground font-mono text-xs text-background focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:px-4 focus:py-3"
      href="#main"
    >
      {header.skipLink}
    </a>

    <SiteHeader homeHref={homeHref}>
      {header.nav.map((link) => (
        <SiteHeaderLink href={localizeHref(link.href, locale)} slot="nav">
          {link.label}
        </SiteHeaderLink>
      ))}

      <CommandPalette alternates={alternates} slot="commandPalette" />

      <ThemeToggle slot="themeToggle">
        <Fragment slot="label">{header.themeToggleLabel}</Fragment>
      </ThemeToggle>

      <Fragment slot="menuLabel">{header.menuLabel}</Fragment>
    </SiteHeader>

    {/* Focusable only from script and the skip link, so the next Tab continues
      from the content; it is not a control, so it draws no focus ring. */}
    <main class="outline-none" id="main" tabindex="-1">
      <slot />
    </main>

    {footer && (
      <SiteFooter homeHref={homeHref}>
        <Fragment slot="tagline">{footer.tagline}</Fragment>
        <ButtonLink
          class="self-start"
          href={localizeHref(footer.action.href, locale)}
          slot="action"
          variant="inverted"
        >
          {footer.action.label}
        </ButtonLink>

        {footer?.columns.map((column) => (
          <SiteFooterColumn slot="columns">
            <Fragment slot="label">{column.label}</Fragment>
            {column.links.map((link) => (
              <SiteFooterLink
                download={link.download}
                href={localizeHref(link.href, locale)}
                slot="links"
              >
                {link.label}
              </SiteFooterLink>
            ))}
          </SiteFooterColumn>
        ))}

        <Fragment slot="colophon">
          <SiteFooterColophon
            repo={footer.colophon.repo}
            text={footer.colophon.text}
          />
        </Fragment>

        <Fragment slot="copyright">{copyright}</Fragment>

        {LOCALES.map((code) => (
          <a
            aria-current={code === locale ? "page" : undefined}
            class:list={[
              "transition-colors",
              code === locale
                ? "text-foreground"
                : "text-muted-foreground hover:text-foreground",
            ]}
            data-locale={code}
            href={alternates[code] ?? localizeHref("/", code)}
            hreflang={code}
            lang={code}
            slot="locales"
          >
            {code}
          </a>
        ))}
      </SiteFooter>
    )}
  </body>
  <script>
    import "@/scripts/alpine"
    import "@/scripts/site-menu"
    import "@/scripts/theme"
    import "@/scripts/favicon"
    import "@/scripts/locale"
  </script>
</html>
