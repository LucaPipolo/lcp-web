---
import "@/styles/global.css"

import SpeedInsights from "@vercel/speed-insights/astro"

import ButtonLink from "@/components/common/ButtonLink.astro"

import SiteFooter from "@/components/sections/SiteFooter/SiteFooter.astro"
import SiteFooterColophon from "@/components/sections/SiteFooter/SiteFooterColophon.astro"
import SiteFooterColumn from "@/components/sections/SiteFooter/SiteFooterColumn.astro"
import SiteFooterLink from "@/components/sections/SiteFooter/SiteFooterLink.astro"

import SiteHeader from "@/components/sections/SiteHeader/SiteHeader.astro"
import SiteHeaderLink from "@/components/sections/SiteHeader/SiteHeaderLink.astro"
import ThemeToggle from "@/components/sections/SiteHeader/ThemeToggle.astro"

import { THEME_INIT_SOURCE } from "@/scripts/theme-init"

interface Props {
  title: string
}

import { getSettings } from "@/libs/content"
import { DEFAULT_LOCALE, isLocale, LOCALES, localizeHref } from "@/libs/i18n"
import { fillPlaceholders } from "@/libs/template"

const locale = Astro.currentLocale
const homeHref = locale && locale !== DEFAULT_LOCALE ? `/${locale}/` : "/"

const path =
  isLocale(locale) && locale !== DEFAULT_LOCALE
    ? Astro.url.pathname.slice(`/${locale}`.length) || "/"
    : Astro.url.pathname

const canonical = new URL(localizeHref(path, locale), Astro.site)

const alternates = LOCALES.map((code) => ({
  code,
  href: new URL(localizeHref(path, code), Astro.site).href,
}))

const { title } = Astro.props

const { header, footer } = await getSettings(locale)

const copyright =
  footer &&
  fillPlaceholders(footer.copyright, {
    year: String(new Date().getFullYear()),
  })
---

<html lang={Astro.currentLocale}>
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width" name="viewport" />
    <link href="/favicon.svg" rel="icon" type="image/svg+xml" />
    <title>{title}</title>
    <link href={canonical.href} rel="canonical" />
    {alternates.map(({ code, href }) => (
      <link href={href} hreflang={code} rel="alternate" />
    ))}
    <link
      href={new URL(localizeHref(path, DEFAULT_LOCALE), Astro.site).href}
      hreflang="x-default"
      rel="alternate"
    />
    <script is:inline set:html={THEME_INIT_SOURCE}></script>
    <SpeedInsights />
  </head>
  <body>
    <SiteHeader homeHref={homeHref}>
      {header.nav.map((link) => (
        <SiteHeaderLink href={localizeHref(link.href, locale)} slot="nav">
          {link.label}
        </SiteHeaderLink>
      ))}

      <ThemeToggle slot="themeToggle">
        <Fragment slot="label">{header.themeToggleLabel}</Fragment>
      </ThemeToggle>

      <Fragment slot="menuLabel">{header.menuLabel}</Fragment>
    </SiteHeader>

    <slot />

    {footer && (
      <SiteFooter homeHref={homeHref}>
        <Fragment slot="tagline">{footer.tagline}</Fragment>
        <ButtonLink
          class="self-start"
          href={footer.action.href}
          slot="action"
          variant="inverted"
        >
          {footer.action.label}
        </ButtonLink>

        {footer?.columns.map((column) => (
          <SiteFooterColumn slot="columns">
            <Fragment slot="label">{column.label}</Fragment>
            {column.links.map((link) => (
              <SiteFooterLink
                download={link.download}
                href={localizeHref(link.href, locale)}
                slot="links"
              >
                {link.label}
              </SiteFooterLink>
            ))}
          </SiteFooterColumn>
        ))}

        <Fragment slot="colophon">
          <SiteFooterColophon
            repo={footer.colophon.repo}
            text={footer.colophon.text}
          />
        </Fragment>

        <Fragment slot="copyright">{copyright}</Fragment>

        {LOCALES.map((code) => (
          <a
            aria-current={code === locale ? "page" : undefined}
            class:list={[
              "transition-colors",
              code === locale
                ? "text-foreground"
                : "text-muted-foreground hover:text-primary",
            ]}
            data-locale={code}
            href={code === DEFAULT_LOCALE ? "/" : `/${code}/`}
            slot="locales"
          >
            {code}
          </a>
        ))}
      </SiteFooter>
    )}
  </body>
  <script>
    import "@/scripts/alpine"
    import "@/scripts/site-menu"
    import "@/scripts/theme"
    import "@/scripts/favicon"
    import "@/scripts/locale"
  </script>
</html>
