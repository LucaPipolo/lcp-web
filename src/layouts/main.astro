---
import "@/styles/global.css"

interface Props {
  title: string
}

const { title } = Astro.props
---

<html lang={Astro.currentLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>

  <script>
    import "@/scripts/favicon"
  </script>
</html>
