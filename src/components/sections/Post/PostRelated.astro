---
import CardGrid from "@/components/common/CardGrid.astro"

for (const slot of ["heading", "posts"]) {
  if (!Astro.slots.has(slot)) {
    throw new Error(
      `<PostRelated> requires a \`${slot}\` slot (pass a <SectionHeading> and at least one <PostCard>).`
    )
  }
}
---

<section>
  <slot name="heading" />

  <CardGrid separators="ruled">
    <slot name="posts" />
  </CardGrid>
</section>
