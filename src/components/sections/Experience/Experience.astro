---
if (!Astro.slots.has("heading")) {
  throw new Error(
    "<Experience> requires a `heading` slot (pass a <SectionHeading>)."
  )
}

if (!Astro.slots.has("roles")) {
  throw new Error(
    "<Experience> requires a `roles` slot (pass at least one <ExperienceRole>)."
  )
}
---

<section id="experience" x-data="experienceRoles">
  <slot name="heading" />

  <div class="flex flex-col gap-8 px-gutter">
    <slot name="roles" />
  </div>
</section>

<script>
  import "@/scripts/experience"
</script>
