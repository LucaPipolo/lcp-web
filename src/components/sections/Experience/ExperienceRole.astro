---
import { Icon } from "astro-icon/components"

interface Props {
  companyHref?: string
  current?: boolean
  id: string
  open?: boolean
}

const { id, current = false, open = false, companyHref } = Astro.props

for (const slot of ["period", "title", "company", "place"]) {
  if (!Astro.slots.has(slot)) {
    throw new Error(`<ExperienceRole> requires a \`${slot}\` slot.`)
  }
}
---

<div class="relative pb-2">
  <span
    aria-hidden="true"
    class:list={[
      "absolute top-2 left-0 -ml-gutter size-2 -translate-x-1/2",
      current ? "bg-primary" : "bg-foreground",
    ]}
  ></span>

  <div class="flex flex-col gap-1.5 pb-3.5">
    <span class="font-mono text-xs text-muted-foreground">
      <slot name="period" />
    </span>

    <button
      aria-controls={`experience-panel-${id}`}
      aria-expanded={open ? "true" : "false"}
      class="group cursor-pointer text-left text-xl font-semibold tracking-tight text-foreground hover:text-primary"
      data-open={open ? "" : undefined}
      data-role={id}
      id={`experience-role-${id}`}
      type="button"
      x-bind:aria-expanded="isOpen($el)"
      x-on:click="toggle($event)"
    >
      <slot name="title" />
      <span
        aria-hidden="true"
        class="absolute top-0 right-0 grid size-7 place-items-center border border-border bg-background font-mono text-base leading-none text-foreground before:content-['+'] group-aria-expanded:before:content-['−']"
      ></span>
    </button>

    <span class="font-mono text-xs text-muted-foreground">
      @{" "}
      {companyHref ? (
        <a
          class="inline-flex items-center gap-1 underline-offset-4 hover:text-primary hover:underline"
          href={companyHref}
          rel="noopener noreferrer"
          target="_blank"
        >
          <slot name="company" />
          <Icon aria-hidden="true" class="size-4" name="lucide:external-link" />
        </a>
      ) : (
        <slot name="company" />
      )}{" "}
      · <slot name="place" />
    </span>
  </div>

  <div
    aria-labelledby={`experience-role-${id}`}
    class="flex flex-col gap-4 pb-6"
    data-role={id}
    id={`experience-panel-${id}`}
    role="region"
    x-cloak
    x-show="isOpen($el)"
  >
    {Astro.slots.has("bullets") && (
      <ul class="flex max-w-prose flex-col gap-2">
        <slot name="bullets" />
      </ul>
    )}

    {Astro.slots.has("skills") && (
      <ul class="flex max-w-prose flex-wrap gap-2">
        <slot name="skills" />
      </ul>
    )}
  </div>
</div>
