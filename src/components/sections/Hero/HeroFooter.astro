---
import CornerMarks from "@/components/common/CornerMarks.astro"

if (!Astro.slots.has("socialLinks")) {
  throw new Error(
    "<HeroFooter> requires a `socialLinks` slot (pass a <SocialLinks>)."
  )
}
---

<div
  class="relative z-10 container mx-auto rise-in border border-border bg-background delay-240"
>
  <CornerMarks />
  <div
    class="grid grid-cols-1 sm:grid-cols-3 sm:[&>a:first-child]:pl-gutter [&>a:not(:first-child)]:border-t [&>a:not(:first-child)]:border-border sm:[&>a:not(:first-child)]:border-t-0 sm:[&>a:not(:first-child)]:border-l"
  >
    <slot name="socialLinks" />
  </div>
</div>
