---
import CornerMarks from "@/components/common/CornerMarks.astro"

if (!Astro.slots.has("socialLinks")) {
  throw new Error(
    "<HeroFooter> requires a `socialLinks` slot (pass a <SocialLinks>)."
  )
}
---

<div
  class="relative z-10 container mx-auto rise-in border border-border delay-240"
>
  <CornerMarks />
  <div class="grid gap-px bg-border sm:grid-cols-3 sm:*:first:pl-gutter">
    <slot name="socialLinks" />
  </div>
</div>
