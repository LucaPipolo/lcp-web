---
import HeroGrid from "./HeroGrid.astro"

if (!Astro.slots.has("header")) {
  throw new Error("<Hero> requires a `header` slot (pass a <HeroHeader>).")
}

if (!Astro.slots.has("footer")) {
  throw new Error("<Hero> requires a `footer` slot (pass a <HeroFooter>).")
}
---

<section class="relative pt-20">
  <HeroGrid />
  <div class="relative z-10 container mx-auto pb-20">
    <div class="flex flex-col items-start gap-6 px-gutter">
      <slot name="header" />
      {
        Astro.slots.has("body") && (
          <p class="max-w-prose rise-in text-lg text-pretty text-muted-foreground delay-80 [&_.text-primary]:font-medium">
            <slot name="body" />
          </p>
        )
      }
      <div class="flex rise-in flex-wrap gap-3 delay-160">
        <slot name="actions" />
      </div>
    </div>
  </div>

  <slot name="footer" />
</section>
