---
interface Props {
  stem: string
  tails: string[]
}

const { stem, tails } = Astro.props
---

<p
  data-hero-badge
  class="group flex items-center gap-2 font-mono text-xs text-muted-foreground lowercase"
>
  <span
    data-badge-spinner
    aria-hidden="true"
    class="inline-block w-[1ch] text-primary"></span>
  <span>
    {stem}{" "}
    {
      tails.map((tail: string, index: number) => (
        <span
          data-badge-tail
          hidden={index > 0}
          aria-hidden={index > 0 ? "true" : undefined}
        >
          {tail}
        </span>
      ))
    }
  </span>
  <span aria-hidden="true" class="caret group-data-typing:caret-steady"></span>
</p>

<script>
  import "@/scripts/hero-badge"
</script>
