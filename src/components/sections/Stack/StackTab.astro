---
interface Props {
  id: string
}

const { id } = Astro.props

if (!Astro.slots.has("default")) {
  throw new Error("<StackTab> requires content.")
}
---

<button
  type="button"
  role="tab"
  data-tab={id}
  id={`stack-tab-${id}`}
  aria-controls={`stack-panel-${id}`}
  x-on:click="select($event)"
  x-on:keydown="navigate($event)"
  x-bind:aria-selected="isSelected($el)"
  x-bind:tabindex="isSelected($el) ? 0 : -1"
  class="cursor-pointer border-b border-transparent pb-1 font-mono text-2xs tracking-wider text-muted-foreground lowercase transition-colors hover:text-foreground aria-selected:border-primary aria-selected:text-foreground"
>
  <slot />
</button>
