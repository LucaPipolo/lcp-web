---
interface Props {
  id: string
}

const { id } = Astro.props

if (!Astro.slots.has("default")) {
  throw new Error("<StackPanel> requires content (pass <StackGroup> children).")
}
---

<div
  aria-labelledby={`stack-tab-${id}`}
  class="flex flex-col gap-6"
  data-tab={id}
  id={`stack-panel-${id}`}
  role="tabpanel"
  x-cloak
  x-show="isSelected($el)"
>
  <slot />
</div>
