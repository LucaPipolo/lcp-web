---
import { Icon } from "astro-icon/components"

if (!Astro.slots.has("label")) {
  throw new Error("<ThemeToggle> requires a `label` slot.")
}
---

<button
  class="grid size-8 cursor-pointer place-items-center border border-border text-muted-foreground transition-colors hover:border-primary hover:text-primary"
  type="button"
  x-data="themeToggle"
  x-on:click="toggle()"
>
  <span class="sr-only">
    <slot name="label" />
  </span>
  <Icon aria-hidden="true" class="size-4 dark:hidden" name="lucide:moon" />
  <Icon aria-hidden="true" class="hidden size-4 dark:block" name="lucide:sun" />
</button>
