---
import { Icon } from "astro-icon/components"

import Wordmark from "@/components/common/Wordmark.astro"

import { getSettings } from "@/libs/content"

interface Props {
  homeHref: string
}

const { homeHref } = Astro.props

const { header } = await getSettings(Astro.currentLocale)

for (const slot of ["nav", "themeToggle", "menuLabel"]) {
  if (!Astro.slots.has(slot)) {
    throw new Error(`<SiteHeader> requires a \`${slot}\` slot.`)
  }
}
---

<header
  class="sticky top-0 z-30"
  x-data="siteMenu"
  x-on:keydown.escape.window="close()"
>
  <div class="border-b border-border bg-background/85 backdrop-blur-md">
    <div class="container mx-auto flex h-header items-center gap-4 border-x border-border px-gutter">
      <Wordmark class="text-lg leading-none" href={homeHref} />

      {/* Inline from `md`: six links in the longest language need about
        670px, so from `sm` they would push the page sideways. */}
      <nav
        aria-label={header.navLabel}
        class="ml-auto hidden items-center gap-6 font-mono text-xs md:flex"
      >
        <span aria-hidden="true" class="text-primary">
          //
        </span>
        <slot name="nav" />
      </nav>

      <div class="ml-auto flex items-center gap-1.5 md:ml-6">
        <slot name="commandPalette" />
        <slot name="themeToggle" />

        <button
          aria-controls="site-menu"
          class="grid size-8 cursor-pointer place-items-center border border-border text-muted-foreground transition-colors hover:border-primary hover:text-primary md:hidden"
          type="button"
          x-bind:aria-expanded="open"
          x-on:click="toggle()"
          x-ref="button"
        >
          <span class="sr-only">
            <slot name="menuLabel" />
          </span>
          <Icon
            aria-hidden="true"
            class="col-start-1 row-start-1 size-4"
            name="lucide:menu"
            x-show="!open"
          />
          <Icon
            aria-hidden="true"
            class="col-start-1 row-start-1 size-4"
            name="lucide:x"
            x-cloak=""
            x-show="open"
          />
        </button>
      </div>
    </div>
  </div>

  <div
    class="absolute inset-x-0 top-full md:hidden!"
    id="site-menu"
    x-cloak=""
    x-on:click="close()"
    x-ref="panel"
    x-show="open"
    x-transition:enter="transition duration-200 ease-out"
    x-transition:enter-end="translate-y-0 opacity-100"
    x-transition:enter-start="-translate-y-3 opacity-0"
    x-transition:leave="transition duration-150 ease-in"
    x-transition:leave-end="-translate-y-3 opacity-0"
    x-transition:leave-start="translate-y-0 opacity-100"
  >
    <div class="container mx-auto border-x border-border bg-background/85 px-gutter backdrop-blur-md">
      <nav
        aria-label={header.navLabel}
        class="flex flex-col font-mono text-base [&>a]:border-b [&>a]:border-border [&>a]:py-4 [&>a:last-child]:border-b-0"
      >
        <slot name="nav" />
      </nav>
    </div>
  </div>
</header>
