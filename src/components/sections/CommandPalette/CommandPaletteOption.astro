---
import type { HTMLAttributes } from "astro/types"

import { Icon } from "astro-icon/components"

import { isExternalHref, NEW_TAB_HINT_ID } from "@/libs/links"
import { cn } from "@/libs/utils"

/**
 * `id` and `search` are left out by an option rendered in the browser, from
 * an `x-for` template, which binds them instead.
 */
type Props = HTMLAttributes<"a"> & {
  id?: string
  search?: string
}

const { class: className, search, ...rest } = Astro.props

if (!Astro.slots.has("default")) {
  throw new Error("<CommandPaletteOption> requires a label.")
}

// A command that goes somewhere is a link; one that does something in place,
// such as switching the theme, is a button.
const Tag = rest.href || "x-bind:href" in rest ? "a" : "button"

// Leaving the site opens a new tab, as every other external link here does.
const external =
  typeof rest.href === "string" &&
  Astro.site !== undefined &&
  isExternalHref(rest.href, Astro.site.href)
---

{/* Never focused itself: focus stays in the input, which points at the
  highlighted option, so `tabindex` keeps it out of the Tab order.

  The caller's attributes come first: Alpine evaluates bindings in order, and
  a bound `data-search` must be in place before `hidden` reads it. */}
<Tag
  {...rest}
  aria-describedby={external ? NEW_TAB_HINT_ID : undefined}
  aria-selected="false"
  class={cn(
    "flex w-full cursor-pointer items-center px-4 py-2 text-left font-mono text-sm text-muted-foreground lowercase aria-selected:bg-muted aria-selected:text-foreground",
    className
  )}
  data-search={search}
  rel={external ? "noopener noreferrer" : undefined}
  role="option"
  tabindex="-1"
  target={external ? "_blank" : undefined}
  type={Tag === "button" ? "button" : undefined}
  x-bind:aria-selected="isActive($el)"
  x-bind:hidden="!matches($el)"
  x-on:pointermove="activate($el)"
>
  <slot />
  {external && (
    <Icon
      aria-hidden="true"
      class="ml-auto size-3.5 shrink-0"
      name="lucide:external-link"
    />
  )}
</Tag>
