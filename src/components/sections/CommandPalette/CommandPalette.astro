---
import { Icon } from "astro-icon/components"

import CommandPaletteGroup from "@/components/sections/CommandPalette/CommandPaletteGroup.astro"
import CommandPaletteOption from "@/components/sections/CommandPalette/CommandPaletteOption.astro"

import { getFeedHref, getPostIndexHref } from "@/libs/blog"
import { REPO_HREF } from "@/libs/brand"
import { getSettings } from "@/libs/content"
import {
  type Alternates,
  DEFAULT_LOCALE,
  isLocale,
  LOCALES,
  localizeHref,
} from "@/libs/i18n"

interface Props {
  alternates: Alternates
}

const { alternates } = Astro.props

const locale = isLocale(Astro.currentLocale)
  ? Astro.currentLocale
  : DEFAULT_LOCALE

const {
  blog,
  commandPalette: copy,
  footer,
  header,
  socialLinks,
} = await getSettings(locale)

/**
 * A command either goes somewhere, by `href`, or runs in place, by `command`
 * and the `value` it takes, which `src/scripts/command-palette.ts` reads.
 */
interface Command {
  command?: "copy" | "theme"
  download?: boolean
  href?: string
  /** What `commandPalette.keywords` names it by, see the schema. */
  key: string
  label: string
  value?: string
}

/**
 * We decided to list the footer's own columns rather than a list of the
 * palette's own, because the footer already names every page worth reaching,
 * grouped and translated, and a second list would drift from it.
 */
const columns = (footer?.columns ?? []).map((column, index) => ({
  label: column.label,
  commands: [
    // Home has no link in the footer, whose wordmark stands in for one.
    ...(index === 0 ? [{ label: copy.home, href: "/" }] : []),
    ...column.links,
  ].map((link): Command => ({
    ...link,
    href: localizeHref(link.href, locale),
    key: link.href,
  })),
}))

const email = socialLinks.find(({ platform }) => platform === "email")

const actions: Command[] = [
  ...(email
    ? [
        { label: copy.actions.email, href: email.href, key: "email" },
        {
          key: "copyEmail",
          label: copy.actions.copyEmail,
          command: "copy" as const,
          value: email.href.replace(/^mailto:/, ""),
        },
      ]
    : []),
  // No value: the page's own address is only known in the browser.
  { label: copy.actions.copyLink, command: "copy", key: "copyLink" },
  { label: blog.feed, href: getFeedHref(locale), key: "feed" },
  { label: copy.actions.source, href: REPO_HREF, key: "source" },
]

const themes = (["light", "dark", "system"] as const).map((value): Command => ({
  label: copy.theme[value],
  command: "theme",
  key: value,
  value,
}))

const keywords = copy.keywords ?? {}

const known = new Set(
  [...columns.flatMap(({ commands }) => commands), ...actions, ...themes].map(
    ({ key }) => key
  )
)

for (const key of Object.keys(keywords)) {
  if (!known.has(key)) {
    throw new Error(
      `The command palette has keywords for \`${key}\`, which names no command. Rename or remove it under \`commandPalette.keywords\` in src/content/settings/${locale}.yaml.`
    )
  }
}

/**
 * Words what a command answers to: its group, its label, and any keywords
 * content gives it, which are searched but never shown.
 */
const searchText = (group: string, { key, label }: Command) =>
  [group, label, keywords[key]].filter(Boolean).join(" ")

const languages = LOCALES.map((code) => ({
  code,
  href: alternates[code] ?? localizeHref("/", code),
  label: new Intl.DisplayNames([code], { type: "language" }).of(code) ?? code,
}))

// Posts are headed by the blog's own name in the navigation.
const postsLabel = header.nav.find(({ href }) => href === "/blog/")?.label

let count = 0
const nextId = () => `command-palette-option-${count++}`
---

<div
  class="contents"
  data-empty={copy.empty}
  data-posts={postsLabel && getPostIndexHref(locale)}
  data-posts-label={postsLabel}
  data-results-one={copy.results.one}
  data-results-other={copy.results.other}
  x-data="commandPalette"
  x-on:keydown.window="shortcut($event)"
>
  {/* A shortcut hint rather than an icon, so the button teaches the key
      that opens it; hidden on narrow screens, which rarely have a keyboard. */}
  <button
    aria-haspopup="dialog"
    aria-keyshortcuts="Meta+K Control+K"
    class="hidden h-8 cursor-pointer items-center border border-border px-2 font-mono text-xs text-muted-foreground transition-colors hover:border-primary hover:text-primary md:flex"
    type="button"
    x-on:click="open()"
  >
    <span class="sr-only">{copy.open}</span>
    <kbd aria-hidden="true" x-text="shortcutLabel()">
      ⌘K
    </kbd>
  </button>

  <dialog
    aria-label={copy.label}
    class="mx-auto mt-24 w-[calc(100%-var(--spacing-gutter)*2)] max-w-xl border border-border bg-background text-foreground shadow-lg backdrop:bg-foreground/20 backdrop:backdrop-blur-sm"
    x-on:click="dismiss($event)"
    x-ref="dialog"
  >
    <div class="relative border-b border-border">
      <Icon
        aria-hidden="true"
        class="pointer-events-none absolute top-1/2 left-4 size-4 -translate-y-1/2 text-muted-foreground"
        name="lucide:search"
      />
      {/* The input is the palette's only focus stop, and its caret already
          marks it, so it draws no outline of its own. */}
      <input
        aria-autocomplete="list"
        aria-controls="command-palette-list"
        aria-expanded="true"
        aria-label={copy.label}
        autocomplete="off"
        class="h-12 w-full bg-transparent pr-4 pl-11 text-base outline-none placeholder:text-muted-foreground"
        placeholder={copy.placeholder}
        role="combobox"
        spellcheck="false"
        type="text"
        x-bind:aria-activedescendant="activeId"
        x-model="query"
        x-on:input="search()"
        x-on:keydown="move($event)"
      />
    </div>

    <div
      aria-label={copy.label}
      class="max-h-80 overflow-y-auto py-1"
      id="command-palette-list"
      role="listbox"
      x-on:click="choose($event)"
    >
      {columns.map((column, index) => (
        <CommandPaletteGroup id={`command-palette-group-${index}`}>
          <Fragment slot="label">{column.label}</Fragment>
          {column.commands.map((command) => (
            <CommandPaletteOption
              download={command.download}
              href={command.href}
              id={nextId()}
              search={searchText(column.label, command)}
            >
              {command.label}
            </CommandPaletteOption>
          ))}
        </CommandPaletteGroup>
      ))}

      <CommandPaletteGroup id="command-palette-group-actions">
        <Fragment slot="label">{copy.groups.actions}</Fragment>
        {actions.map((command) => (
          <CommandPaletteOption
            data-command={command.command}
            data-value={command.value}
            href={command.href}
            id={nextId()}
            search={searchText(copy.groups.actions, command)}
          >
            {command.command === "copy" ? (
              <>
                <span x-bind:hidden="isCopied($el)">{command.label}</span>
                <span hidden x-bind:hidden="!isCopied($el)">
                  {copy.actions.copied}
                </span>
              </>
            ) : (
              command.label
            )}
          </CommandPaletteOption>
        ))}
      </CommandPaletteGroup>

      <CommandPaletteGroup id="command-palette-group-theme">
        <Fragment slot="label">{copy.groups.theme}</Fragment>
        {themes.map((command) => (
          <CommandPaletteOption
            data-command={command.command}
            data-value={command.value}
            id={nextId()}
            search={searchText(copy.groups.theme, command)}
          >
            {command.label}
          </CommandPaletteOption>
        ))}
      </CommandPaletteGroup>

      <CommandPaletteGroup id="command-palette-group-language">
        <Fragment slot="label">{copy.groups.language}</Fragment>
        {languages.map(({ code, href, label }) => (
          <CommandPaletteOption
            aria-current={code === locale ? "page" : undefined}
            data-locale={code}
            href={href}
            hreflang={code}
            id={nextId()}
            lang={code}
            search={`${copy.groups.language} ${code} ${label}`}
          >
            {label}
          </CommandPaletteOption>
        ))}
      </CommandPaletteGroup>

      {postsLabel && (
        <CommandPaletteGroup id="command-palette-group-posts">
          <Fragment slot="label">{postsLabel}</Fragment>
          <template x-bind:key="post.id" x-for="post in shownPosts()">
            {/* A title is prose, so it keeps its own capitals. */}
            <CommandPaletteOption
              class="normal-case"
              x-bind:data-search="post.search"
              x-bind:href="post.href"
              x-bind:id="post.id"
            >
              <span x-text="post.title" />
            </CommandPaletteOption>
          </template>
        </CommandPaletteGroup>
      )}
    </div>

    <p
      class="px-4 py-8 text-center text-sm text-muted-foreground"
      hidden
      x-bind:hidden="hasResults()"
    >
      {copy.empty}
    </p>

    <p aria-live="polite" class="sr-only" x-text="status()" />

    <div
      aria-hidden="true"
      class="flex gap-4 border-t border-border px-4 py-2 font-mono text-2xs text-muted-foreground"
    >
      <span>
        <kbd class="text-foreground">↑↓</kbd> {copy.keys.navigate}
      </span>
      <span>
        <kbd class="text-foreground">↵</kbd> {copy.keys.select}
      </span>
      <span>
        <kbd class="text-foreground">esc</kbd> {copy.keys.close}
      </span>
    </div>
  </dialog>
</div>

<script>
  import "@/scripts/command-palette"
</script>
