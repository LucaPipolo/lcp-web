---
interface Props {
  id: string
}

const { id } = Astro.props

for (const slot of ["label", "default"]) {
  if (!Astro.slots.has(slot)) {
    throw new Error(`<CommandPaletteGroup> requires a \`${slot}\` slot.`)
  }
}
---

<div
  aria-labelledby={id}
  class="py-1"
  role="group"
  x-bind:hidden="!hasMatches($el)"
>
  <div
    class="flex gap-1.5 px-4 pt-2 pb-1 font-mono text-2xs tracking-wider text-muted-foreground uppercase"
    id={id}
    role="presentation"
  >
    <span aria-hidden="true" class="text-primary">
      //
    </span>
    <slot name="label" />
  </div>
  <slot />
</div>
