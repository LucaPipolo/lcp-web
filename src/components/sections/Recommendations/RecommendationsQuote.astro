---
import { Icon } from "astro-icon/components"

interface Props {
  avatar?: string
  href?: string
}

const { href, avatar, avatarAlt } = Astro.props

for (const slot of ["initials", "name", "role", "text"]) {
  if (!Astro.slots.has(slot)) {
    throw new Error(`<RecommendationsQuote> requires a \`${slot}\` slot.`)
  }
}

if (avatar && !avatarAlt) {
  throw new Error(
    "<RecommendationsQuote> requires `avatarAlt` alongside `avatar` (pass the author's name)."
  )
}
---

<figure class="group/quote flex flex-col gap-4 bg-background px-gutter pt-6 pb-8">
  <figcaption class="flex items-center gap-3">
    {avatar ? (
      <span class="duotone size-9 flex-none border border-border group-hover/quote:duotone-off">
        <img
          alt={avatarAlt}
          decoding="async"
          height="36"
          loading="lazy"
          src={avatar}
          width="36"
        />
      </span>
    ) : (
      <span
        aria-hidden="true"
        class="grid size-9 flex-none place-items-center border border-border font-mono text-2xs tracking-wide text-muted-foreground"
      >
        <slot name="initials" />
      </span>
    )}
    <span class="flex min-w-0 flex-col gap-1">
      <span class="text-sm font-semibold text-foreground">
        {href ? (
          <a
            class="inline-flex items-center gap-1.5 underline-offset-4 hover:text-primary hover:underline"
            href={href}
            rel="noreferrer"
            target="_blank"
          >
            <slot name="name" />
            <Icon
              aria-hidden="true"
              class="size-3"
              name="lucide:external-link"
            />
          </a>
        ) : (
          <slot name="name" />
        )}
      </span>
      <span class="font-mono text-2xs text-muted-foreground">
        <slot name="role" />
      </span>
    </span>
  </figcaption>
  <blockquote class="text-base text-pretty text-muted-foreground">
    <slot name="text" />
  </blockquote>
</figure>
