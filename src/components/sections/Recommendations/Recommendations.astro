---
import CardGrid from "@/components/common/CardGrid.astro"

import { getAnchor } from "@/libs/i18n"

if (!Astro.slots.has("heading")) {
  throw new Error(
    "<Recommendations> requires a `heading` slot (pass a <SectionHeading>)."
  )
}

if (!Astro.slots.has("quotes")) {
  throw new Error(
    "<Recommendations> requires a `quotes` slot (pass at least one <RecommendationsQuote>)."
  )
}
---

<section id={getAnchor("recommendations", Astro.currentLocale)}>
  <slot name="heading" />

  <CardGrid>
    <slot name="quotes" />
  </CardGrid>
</section>
