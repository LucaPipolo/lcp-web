---
import CornerMarks from "@/components/common/CornerMarks.astro"

if (!Astro.slots.has("default")) {
  throw new Error("<CardGrid> requires content.")
}
---

<div class="@container">
  <div
    class="relative grid gap-px border-y border-border bg-border @2xl:grid-cols-2 @5xl:grid-cols-3"
  >
    <CornerMarks />
    <slot />
  </div>
</div>
