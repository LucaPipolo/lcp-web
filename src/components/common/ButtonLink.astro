---
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/libs/utils"

const BASE =
  "inline-flex shrink-0 items-center justify-center border border-transparent text-sm font-medium whitespace-nowrap transition-all outline-none select-none focus-visible:border-gray-400 focus-visible:ring-3 focus-visible:ring-gray-400/50 active:translate-y-px [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4"

const SIZES = {
  md: "h-10 gap-2 px-4",
  lg: "h-12 gap-2 px-5",
} as const

const VARIANTS = {
  default: "bg-primary text-background hover:bg-primary/80",
  outline: "border-border bg-background hover:bg-muted hover:text-foreground",
  inverted: "bg-foreground text-background hover:bg-primary",
} as const

interface Props extends HTMLAttributes<"a"> {
  href: string
  size?: keyof typeof SIZES
  variant?: keyof typeof VARIANTS
}

const {
  href,
  size = "lg",
  variant = "default",
  class: className,
  ...rest
} = Astro.props
---

<a
  href={href}
  data-slot="button"
  class={cn(BASE, SIZES[size], VARIANTS[variant], className)}
  {...rest}
>
  <slot />
</a>
