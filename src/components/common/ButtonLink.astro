---
import type { HTMLAttributes } from "astro/types"

import {
  BUTTON_BASE,
  BUTTON_SIZES,
  BUTTON_VARIANTS,
  type ButtonSize,
  type ButtonVariant,
} from "@/libs/button"
import { cn } from "@/libs/utils"

interface Props extends HTMLAttributes<"a"> {
  href: string
  size?: ButtonSize
  variant?: ButtonVariant
}

const {
  href,
  size = "lg",
  variant = "default",
  class: className,
  ...rest
} = Astro.props
---

<a
  class={cn(
    BUTTON_BASE,
    BUTTON_SIZES[size],
    BUTTON_VARIANTS[variant],
    className
  )}
  data-slot="button"
  href={href}
  {...rest}
>
  <slot />
</a>
