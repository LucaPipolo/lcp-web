---
const CORNERS = {
  all: ["top-left", "top-right", "bottom-left", "bottom-right"],
  top: ["top-left", "top-right"],
  bottom: ["bottom-left", "bottom-right"],
} as const

interface Props {
  corners?: keyof typeof CORNERS
}

const { corners = "all" } = Astro.props
---

{
  CORNERS[corners].map((corner) => (
    <span aria-hidden="true" class="corner-mark" data-corner={corner} />
  ))
}
