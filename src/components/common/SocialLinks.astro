---
import { Icon } from "astro-icon/components"

import { getSettings } from "@/libs/content"

const { socialLinks } = await getSettings(Astro.currentLocale)

const ICONS = {
  github: "simple-icons:github",
  linkedin: "simple-icons:linkedin",
  email: "lucide:mail",
} as const
---

{
  socialLinks.map((socialLink) => (
    <a
      href={socialLink.href}
      aria-label={socialLink.label}
      class="flex min-w-0 items-center gap-3 bg-background px-6 py-5 transition-colors hover:bg-muted"
      target="_blank"
      rel="noopener noreferrer"
    >
      <span class="grid size-10 flex-none place-items-center border border-border text-foreground">
        <Icon
          name={ICONS[socialLink.platform]}
          class="size-5"
          aria-hidden="true"
        />
      </span>
      <span class="flex min-w-0 flex-col">
        <span class="text-sm font-medium text-foreground">
          {socialLink.label}
        </span>
        <span class="truncate font-mono text-2xs text-muted-foreground">
          {socialLink.handle}
        </span>
      </span>
    </a>
  ))
}
