---
import type { HTMLAttributes } from "astro/types"

import Asterisk from "@/components/common/Asterisk.astro"

import { cn } from "@/libs/utils"
interface Props extends HTMLAttributes<"a"> {
  href: string
}

const { href, class: className, ...rest } = Astro.props
---

<a
  class={cn("font-semibold text-foreground transition-colors", className)}
  href={href}
  {...rest}
>
  lucapipolo
  <Asterisk class="ml-[0.05em] inline-block size-[0.42em] align-baseline text-primary" />
</a>
