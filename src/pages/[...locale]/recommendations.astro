---
import Layout from "@/layouts/main.astro"

import MasonryGrid from "@/components/common/MasonryGrid.astro"
import SectionContainer from "@/components/common/SectionContainer.astro"

import RecommendationsQuote from "@/components/sections/Recommendations/RecommendationsQuote.astro"

import { getLocalizedStaticPaths } from "@/libs/content"

export async function getStaticPaths() {
  return getLocalizedStaticPaths("recommendations")
}

const { entry } = Astro.props
const { metadata, title, intro } = entry.data

const quotes = entry.data.quotes.toSorted(
  (a, b) => (b.date?.getTime() ?? 0) - (a.date?.getTime() ?? 0)
)
---

<Layout description={intro} title={metadata.title}>
  <SectionContainer>
    <div class="flex flex-col gap-4 px-gutter pt-20 pb-10">
      <h1 class="max-w-article text-4xl font-semibold tracking-tight text-foreground">
        {title}
      </h1>

      <p class="mt-2 max-w-article rich-text text-lg text-pretty text-muted-foreground">
        {intro}
      </p>
    </div>
  </SectionContainer>

  <SectionContainer>
    <MasonryGrid>
      {quotes.map((quote) => (
        <RecommendationsQuote
          avatar={quote.avatar}
          avatarAlt={quote.name}
          href={quote.href}
        >
          <Fragment slot="initials">{quote.initials}</Fragment>
          <Fragment slot="name">{quote.name}</Fragment>
          <Fragment slot="role">{quote.role}</Fragment>
          <Fragment slot="text">
            {quote.text.split(/\n{2,}/).map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </Fragment>
        </RecommendationsQuote>
      ))}
    </MasonryGrid>
  </SectionContainer>
</Layout>
