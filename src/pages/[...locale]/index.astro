---
import Layout from "@/layouts/main.astro"

import Hero from "@/components/sections/Hero/Hero.astro"
import HeroHeader from "@/components/sections/Hero/HeroHeader.astro"
import HeroBadge from "@/components/sections/Hero/HeroBadge.astro"
import HeroFooter from "@/components/sections/Hero/HeroFooter.astro"

import Experience from "@/components/sections/Experience/Experience.astro"
import ExperienceRole from "@/components/sections/Experience/ExperienceRole.astro"
import ExperienceBullet from "@/components/sections/Experience/ExperienceBullet.astro"
import ExperienceSkill from "@/components/sections/Experience/ExperienceSkill.astro"

import Stack from "@/components/sections/Stack/Stack.astro"
import StackTab from "@/components/sections/Stack/StackTab.astro"
import StackPanel from "@/components/sections/Stack/StackPanel.astro"
import StackGroup from "@/components/sections/Stack/StackGroup.astro"
import StackItem from "@/components/sections/Stack/StackItem.astro"

import Recommendations from "@/components/sections/Recommendations/Recommendations.astro"
import RecommendationsQuote from "@/components/sections/Recommendations/RecommendationsQuote.astro"

import ButtonLink from "@/components/common/ButtonLink.astro"
import SectionHeading from "@/components/common/SectionHeading.astro"
import SectionContainer from "@/components/common/SectionContainer.astro"
import SocialLinks from "@/components/common/SocialLinks.astro"

import { Icon } from "astro-icon/components"

import { getLocalizedStaticPaths } from "@/libs/content"

export async function getStaticPaths() {
  return getLocalizedStaticPaths("home")
}

const { entry } = Astro.props
const { metadata } = entry.data

const { hero, experience, stack, recommendations } = entry.data.sections

const badge = hero.badge
---

<Layout title={metadata.title}>
  <Hero>
    <HeroHeader slot="header">
      {
        badge && (
          <HeroBadge slot="badge" stem={badge.stem} tails={badge.tails} />
        )
      }
      <Fragment slot="heading" set:html={hero.heading} />
      <Fragment slot="subheading">{hero.subheading}</Fragment>
    </HeroHeader>
    <Fragment slot="body" set:html={hero.body} />
    {
      hero.actions.map((action) => (
        <ButtonLink
          slot="actions"
          href={action.href}
          variant={action.variant}
          download={action.download}
        >
          {action.label}
          {action.download && (
            <Icon name="lucide:download" class="size-4" aria-hidden="true" />
          )}
        </ButtonLink>
      ))
    }
    <HeroFooter slot="footer">
      <SocialLinks slot="socialLinks" />
    </HeroFooter>
  </Hero>

  {
    (experience || stack) && (
      <SectionContainer columns={experience && stack ? 2 : 1}>
        {experience && (
          <Experience>
            <SectionHeading slot="heading">{experience.heading}</SectionHeading>
            {experience.roles.map((role, index) => (
              <ExperienceRole
                slot="roles"
                id={String(index)}
                current={index === 0}
                open={index === 0}
                companyHref={role.companyHref}
              >
                <Fragment slot="period">{role.period}</Fragment>
                <Fragment slot="title">{role.title}</Fragment>
                <Fragment slot="company">{role.company}</Fragment>
                <Fragment slot="place">{role.place}</Fragment>
                {role.bullets.map((bullet) => (
                  <ExperienceBullet slot="bullets">{bullet}</ExperienceBullet>
                ))}
                {role.skills?.map((skill) => (
                  <ExperienceSkill slot="skills">{skill}</ExperienceSkill>
                ))}
              </ExperienceRole>
            ))}
          </Experience>
        )}

        {stack && (
          <Stack>
            <SectionHeading slot="heading" actionsRole="tablist">
              {stack.heading}
              {stack.tabs.map((tab) => (
                <StackTab slot="actions" id={tab.id}>
                  {tab.label}
                </StackTab>
              ))}
            </SectionHeading>
            {stack.tabs.map((tab) => (
              <StackPanel slot="panels" id={tab.id}>
                {tab.groups.map((group) => (
                  <StackGroup>
                    <Fragment slot="label">{group.label}</Fragment>
                    {group.items.map((item) => (
                      <StackItem slot="items" slug={item.slug}>
                        {item.name}
                      </StackItem>
                    ))}
                  </StackGroup>
                ))}
              </StackPanel>
            ))}
          </Stack>
        )}
      </SectionContainer>
    )
  }

  {
    recommendations && (
      <SectionContainer>
        <Recommendations>
          <SectionHeading slot="heading">
            {recommendations.heading}
            <ButtonLink
              slot="actions"
              href={recommendations.action.href}
              variant="outline"
              size="md"
              target="_blank"
              rel="noopener noreferrer"
            >
              {recommendations.action.label}
              <Icon
                name="lucide:external-link"
                class="size-4"
                aria-hidden="true"
              />
            </ButtonLink>
          </SectionHeading>
          {recommendations.quotes.map((quote) => (
            <RecommendationsQuote
              slot="quotes"
              href={quote.href}
              avatar={quote.avatar}
              avatarAlt={quote.name}
            >
              <Fragment slot="initials">{quote.initials}</Fragment>
              <Fragment slot="name">{quote.name}</Fragment>
              <Fragment slot="role">{quote.role}</Fragment>
              <Fragment slot="text">{quote.text}</Fragment>
            </RecommendationsQuote>
          ))}
        </Recommendations>
      </SectionContainer>
    )
  }
</Layout>
