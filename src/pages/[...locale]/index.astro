---
import Layout from "@/layouts/main.astro"

import Hero from "@/components/sections/Hero/Hero.astro"
import HeroHeader from "@/components/sections/Hero/HeroHeader.astro"
import HeroBadge from "@/components/sections/Hero/HeroBadge.astro"
import HeroFooter from "@/components/sections/Hero/HeroFooter.astro"

import Recommendations from "@/components/sections/Recommendations/Recommendations.astro"
import RecommendationsQuote from "@/components/sections/Recommendations/RecommendationsQuote.astro"

import ButtonLink from "@/components/common/ButtonLink.astro"
import SectionHeading from "@/components/common/SectionHeading.astro"
import SectionContainer from "@/components/common/SectionContainer.astro"
import SocialLinks from "@/components/common/SocialLinks.astro"

import { Icon } from "astro-icon/components"

import { getLocalizedStaticPaths } from "@/libs/content"

export async function getStaticPaths() {
  return getLocalizedStaticPaths("home")
}

const { entry } = Astro.props
const { metadata } = entry.data

const { hero, recommendations } = entry.data.sections

const badge = hero.badge
---

<Layout title={metadata.title}>
  <Hero>
    <HeroHeader slot="header">
      {
        badge && (
          <HeroBadge slot="badge" stem={badge.stem} tails={badge.tails} />
        )
      }
      <Fragment slot="heading" set:html={hero.heading} />
      <Fragment slot="subheading">{hero.subheading}</Fragment>
    </HeroHeader>
    <Fragment slot="body" set:html={hero.body} />
    {
      hero.actions.map((action) => (
        <ButtonLink
          slot="actions"
          href={action.href}
          variant={action.variant}
          download={action.download}
        >
          {action.label}
          {action.download && (
            <Icon name="lucide:download" class="h-4 w-4" aria-hidden="true" />
          )}
        </ButtonLink>
      ))
    }
    <HeroFooter slot="footer">
      <SocialLinks slot="socialLinks" />
    </HeroFooter>
  </Hero>

  {
    recommendations && (
      <SectionContainer>
        <Recommendations>
          <SectionHeading slot="heading">
            {recommendations.heading}
            <ButtonLink
              slot="actions"
              href={recommendations.action.href}
              variant="outline"
              class="h-9.5 gap-2 px-4 text-[13.5px]"
              target="_blank"
              rel="noopener noreferrer"
            >
              {recommendations.action.label}
              <Icon
                name="lucide:external-link"
                class="size-4"
                aria-hidden="true"
              />
            </ButtonLink>
          </SectionHeading>
          {recommendations.quotes.map((quote) => (
            <RecommendationsQuote
              slot="quotes"
              href={quote.href}
              avatar={quote.avatar}
              avatarAlt={quote.name}
            >
              <Fragment slot="initials">{quote.initials}</Fragment>
              <Fragment slot="name">{quote.name}</Fragment>
              <Fragment slot="role">{quote.role}</Fragment>
              <Fragment slot="text">{quote.text}</Fragment>
            </RecommendationsQuote>
          ))}
        </Recommendations>
      </SectionContainer>
    )
  }
</Layout>
