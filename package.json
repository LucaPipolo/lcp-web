{
  "name": "lcp-web",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare": "husky",
    "astro": "astro",
    "lint": "eslint .",
    "format:check": "prettier --check \"**/*.{ts,tsx,astro}\"",
    "format": "prettier --write \"**/*.{ts,tsx,astro}\"",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview"
  },
  "lint-staged": {
    "*.{ts,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{tsx,js,mjs,cjs,json,md,css,yaml,yml}": "prettier --write"
  },
  "dependencies": {
    "@alpinejs/csp": "^3.16.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@iconify-json/lucide": "^1.2.121",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.6",
    "astro-icon": "^1.1.5",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@iconify-json/simple-icons": "^1.2.93",
    "eslint": "^10.8.0",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwind-merge": "^3.6.0",
    "typescript": "~6",
    "typescript-eslint": "^8.66.0"
  }
}
