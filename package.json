{
  "name": "lcp-web",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare": "husky",
    "astro": "astro",
    "lint": "eslint .",
    "format:check": "prettier --check . && eslint .",
    "format": "eslint . --fix && prettier --write .",
    "check:csp": "node check-csp.mjs",
    "dev": "astro dev",
    "build": "astro build && bun run check:csp",
    "preview": "astro preview",
    "notify": "bun scripts/notify.ts"
  },
  "lint-staged": {
    "*.{ts,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{tsx,js,mjs,cjs,json,md,css,yaml,yml}": "prettier --write"
  },
  "dependencies": {
    "@alpinejs/csp": "^3.17.5",
    "@astrojs/markdown-satteri": "^0.4.7",
    "@astrojs/rss": "^4.0.19",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@iconify-json/lucide": "^1.2.152",
    "@neondatabase/serverless": "^1.2.0",
    "@sentry/astro": "^10.74.0",
    "@tailwindcss/vite": "^4.3.5",
    "@vercel/functions": "^3.11.0",
    "@vercel/speed-insights": "^2.1.0",
    "astro": "^7.4.7",
    "astro-icon": "^1.2.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@iconify-json/simple-icons": "^1.2.101",
    "clsx": "^2.1.1",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.13.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwind-merge": "^3.7.0",
    "typescript": "~6",
    "typescript-eslint": "^8.72.1"
  }
}
