{
  "name": "lcp-web",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare": "husky",
    "astro": "astro",
    "lint": "eslint .",
    "format:check": "prettier --check . && eslint .",
    "format": "eslint . --fix && prettier --write .",
    "check:audit": "bun audit --audit-level=high",
    "check:csp": "node check-csp.mjs",
    "check:type": "astro check",
    "dev": "astro dev",
    "build": "astro build && bun run check:csp",
    "preview": "astro preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "notify": "bun scripts/notify.ts"
  },
  "lint-staged": {
    "*.{ts,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{tsx,js,mjs,cjs,json,md,css,yaml,yml}": "prettier --write"
  },
  "dependencies": {
    "@alpinejs/csp": "^3.17.5",
    "@astrojs/markdown-satteri": "^0.4.8",
    "@astrojs/rss": "^4.0.19",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@iconify-json/lucide": "^1.2.153",
    "@neondatabase/serverless": "^1.2.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/astro": "^11.12.0",
    "@tailwindcss/vite": "^4.3.5",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.11.1",
    "@vercel/speed-insights": "^2.1.0",
    "astro": "^7.4.10",
    "astro-icon": "^1.2.0",
    "github-slugger": "2.0.0",
    "satori": "^0.63.2",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@iconify-json/simple-icons": "^1.2.102",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "clsx": "^2.1.1",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.13.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "satteri": "^0.11.6",
    "tailwind-merge": "^3.7.0",
    "typescript": "~6",
    "typescript-eslint": "^8.72.2",
    "vitest": "5.1.0"
  },
  "patchedDependencies": {
    "@alpinejs/csp@3.17.5": "patches/@alpinejs%2Fcsp@3.17.5.patch"
  }
}
