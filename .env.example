# -----------------------------------------------------------------
# Docker settings
#
# These settings are used by the ./scripts/setup.sh to spin
# multiple instances of the application on the same host.
# This is specially useful when working with AI agents and git
# worktrees. You can leave it blank, the script will take care
# of filling the values for you.
# -----------------------------------------------------------------

COMPOSE_PROJECT_NAME=lcp-web

BASE_NAME=lcp-web
BASE_DOMAIN=lcp-web.test

ROUTER_NAME=lcp-web-router

CONTAINER_PORT=4321
APP_PORT=4321

# Absolute path of the shared git directory. Bind mounted into the
# container so git works inside git worktrees.
GIT_COMMON_DIR=

# ! LEAVE BLANK !
# Docker Compose sets it to 443 inside the container, where the
# browser reaches the router. Filling it in here would break its
# hot reloading.
ASTRO_DEV_HMR_CLIENT_PORT=

# -----------------------------------------------------------------
# Sentry settings
# -----------------------------------------------------------------
SENTRY_AUTH_TOKEN=
